    "controllerServices": [
      {
        "identifier": "csv-reader-service",
        "instanceIdentifier": "csv-reader-instance",
        "name": "CSVReader",
        "comments": "Reads CSV files with header-inferred schema",
        "type": "org.apache.nifi.csv.CSVReader",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-record-serialization-services-nar",
          "version": "2.5.0"
        },
        "properties": {
          "schema-access-strategy": "csv-header-derived",
          "csv-format": "RFC4180",
          "Skip Header Line": "true",
          "csvutils-character-set": "UTF-8",
          "Trim Fields": "true",
          "Quote Character": "\"",
          "Escape Character": "\\",
          "Comment Marker": null,
          "Value Separator": ",",
          "Record Separator": "\\n",
          "Date Format": null,
          "Time Format": null,
          "Timestamp Format": null
        },
