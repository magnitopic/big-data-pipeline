# ==========================================
# ENVIRONMENT VARIABLES
# Copy this file to .env and update values
# ==========================================

# NiFi Credentials
NIFI_USERNAME=admin
NIFI_PASSWORD=adminadminadmin

# Mariadb env vars
MYSQL_USER=mag
MYSQL_PASSWORD=pass123
MYSQL_ROOT_PASSWORD=pass123
MYSQL_DATABASE=flight_delays
MYSQL_HOSTNAME=mariadb

# MongoDB Credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin_password
MONGO_DATABASE=flight_delays

# API Keys
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENWEATHER_API_KEY=

# Resource Limits (adjust based on your machine)
NIFI_JVM_HEAP_INIT=2g
NIFI_JVM_HEAP_MAX=4g
FLINK_JOBMANAGER_MEMORY=2048m
FLINK_TASKMANAGER_MEMORY=2048m
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
